# Copy to `.env` and fill in real values. Never commit `.env`.
#
# The database and Neon Auth values are the same ones `neon env pull` writes for
# the branch. See docs/backend/auth-and-tenancy-design.md.
#
# Every value is required unless marked optional — the app has no in-code
# defaults, so a missing variable fails fast at startup.

# --- Server ---
# Bind address for the local dev server (`uv run api`). Required — no defaults.
HOST=127.0.0.1
PORT=8000

# --- Database (Neon / Lakebase Postgres) ---
# Pooled connection (runtime).
DATABASE_URL=
# Direct connection (migrations only).
DATABASE_URL_UNPOOLED=

# --- Neon Auth (Managed Better Auth) ---
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Optional: expected JWT issuer. Defaults to NEON_AUTH_BASE_URL.
# NEON_AUTH_ISSUER=
# Disable only while diagnosing a 401.
JWT_VERIFY_ISSUER=true

# --- Application ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
# Product name used in branded emails (subject + header).
APP_NAME=RJS Accounts

# --- App mailer (provider-agnostic) ---
# One mailer sends every platform email (sign-in/verification OTP, magic links,
# provisioning notices). MAIL_PROVIDER picks the transport; with `auto` it is
# detected: Resend if RESEND_API_KEY is set, else SMTP if SMTP_HOST is set,
# else messages are only logged (development).
#
# NOTE: this mailer also delivers the sign-in / verification OTP once Neon Auth
# webhooks are enabled (POST /api/v1/auth/webhooks/neon). With no transport
# configured that endpoint answers 503 so a lost code is never silent — see
# docs/backend/auth-and-tenancy-design.md.
MAIL_PROVIDER=smtp
# Shared From address for every transport (falls back to SMTP_FROM),
# e.g. "RJS Accounts <no-reply@yourdomain.com>".
MAIL_FROM=

# --- SMTP transport (used when MAIL_PROVIDER=smtp) ---
#   Gmail       — smtp.gmail.com:587, user <address>, password = a 16-char
#                 Google *app password* (requires 2-Step Verification)
#   Resend SMTP — smtp.resend.com:587, user "resend", password = the API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Resend HTTP API (alternative to SMTP) ---
# Requires a verified sending domain at https://resend.com/domains. Until then
# `onboarding@resend.dev` only delivers to the Resend account owner's address.
RESEND_API_KEY=

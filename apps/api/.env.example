# Copy to `.env` and fill in real values. Never commit `.env`.
#
# The database and Neon Auth values are the same ones `neon env pull` writes for
# the branch. See docs/backend/auth-and-tenancy-design.md.

# --- Database (Neon / Lakebase Postgres) ---
# Pooled connection (runtime).
DATABASE_URL=
# Direct connection (migrations only).
DATABASE_URL_UNPOOLED=

# --- Neon Auth (Managed Better Auth) ---
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Optional: expected JWT issuer. Defaults to NEON_AUTH_BASE_URL.
# NEON_AUTH_ISSUER=
# Disable only while diagnosing a 401.
JWT_VERIFY_ISSUER=true

# --- Application ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
# Product name used in branded emails (subject + header).
APP_NAME=RJS Accounts

# --- App mailer (provider-agnostic) ---
# Transport is auto-detected: Resend if RESEND_API_KEY is set, else SMTP if
# SMTP_HOST is set, else messages are logged (development). Force one with
# MAIL_PROVIDER=resend|smtp|auto.
#
# NOTE: this mailer also delivers the sign-in / verification OTP once Neon Auth
# webhooks are enabled (POST /api/v1/auth/webhooks/neon). With no transport
# configured that endpoint answers 503 so a lost code is never silent — see
# docs/backend/auth-and-tenancy-design.md.

# Resend (https://resend.com) HTTP API. The From domain must be verified there.
# Until a domain is verified, use the test sender `onboarding@resend.dev` — it
# only delivers to the Resend account owner's own address.
RESEND_API_KEY=
# Shared From address for every transport (falls back to SMTP_FROM),
# e.g. "RJS Accounts <no-reply@yourdomain.com>".
MAIL_FROM=

# SMTP (optional). Also works with Resend SMTP: smtp.resend.com:587, user "resend".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

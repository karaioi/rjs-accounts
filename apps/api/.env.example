# Copy to `.env` and fill in real values. Never commit `.env`.
#
# The database and Neon Auth values are the same ones `neon env pull` writes for
# the branch. See docs/backend/auth-and-tenancy-design.md.

# --- Database (Neon / Lakebase Postgres) ---
# Pooled connection (runtime).
DATABASE_URL=
# Direct connection (migrations only).
DATABASE_URL_UNPOOLED=

# --- Neon Auth (Managed Better Auth) ---
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Optional: expected JWT issuer. Defaults to NEON_AUTH_BASE_URL.
# NEON_AUTH_ISSUER=
# Disable only while diagnosing a 401.
JWT_VERIFY_ISSUER=true

# --- Application ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# --- App mailer (provider-agnostic SMTP) ---
# Leave empty in development: the mailer logs instead of sending.
# Later, Resend (or any SMTP provider) fills the same variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

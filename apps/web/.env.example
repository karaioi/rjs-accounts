# Neon — rjs-accounts
# Copy to .env.local and fill in, or let Neon write it:
#   cp apps/web/.env.example apps/web/.env.local
#   neon env pull --file apps/web/.env.local

# Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Branch
NEON_BRANCH=

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

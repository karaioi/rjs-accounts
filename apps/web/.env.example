# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# The web app only needs Auth values. Database and object-storage credentials
# belong to `apps/api` — the browser-capable app must never hold them.
# See docs/backend/auth-and-tenancy-design.md.

# Neon Auth (Managed Better Auth) — same values `neon env pull` writes.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Signs the cached session cookies. Generate with:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Base URL of the FastAPI backend. Used server-side only (route handlers), so
# it is not exposed to the browser and does not need a NEXT_PUBLIC_ prefix.
API_BASE_URL=http://127.0.0.1:8000

# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# The web app only needs Auth values. Database and object-storage credentials
# belong to `apps/api` — the browser-capable app must never hold them.
# See docs/backend/auth-and-tenancy-design.md.
#
# Every value below is required: the app has no in-code defaults, so a missing
# variable fails fast instead of falling back to a dev value.

# Neon Auth (Managed Better Auth). `NEON_AUTH_BASE_URL` comes from
# `neon neon-auth status`.
NEON_AUTH_BASE_URL= https://ep-plain-resonance-b3hfod20.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth

# Signs the cached session cookies. Generate with:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=7FBkfyVg5692h9/zpi3upI2C8F1o7sEAziqObBGTPKo=

# Base URL of the FastAPI backend. Used server-side only (route handlers), so
# it is not exposed to the browser and does not need a NEXT_PUBLIC_ prefix.
API_BASE_URL=http://127.0.0.1:8000
